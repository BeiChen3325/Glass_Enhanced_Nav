# Machine-local runtime configuration. Repository paths are inferred from the
# location of go2_internnav_navdp_deployment, so this file works under either
# /home/unitree or /home/robot.
NAVDP_CONDA_DIR_NAME=ENTER

NAVDP_SERVER_HOST=192.168.8.251
NAVDP_SERVER_PORT=5802
NAVDP_SERVER_DEVICE=cuda:0
NAVDP_CAMERA_INFO_MODE=effective
